        <questionvariables>
            <text><![CDATA[a: rand([2,4,6,8])
w: rand(5)+2
phi: rand([%pi/4, %pi/3])
T: 2*%pi/w

funcs:[a*sin(w*t), a*sin(w*t+phi), a*sin(w/2*t), (a/2)*sin(w*t)];
/* Choose functions to plot */
funcstoplot:rand_selection(funcs,4);
/* permute the graphs but keep note of which ones are right! */
reordering:random_permutation([1,2,3,4]);
fntoletter:zip_with("[",reordering,[A,B,C,D]);
/* apply the reordering to produce the shuffled list of options */
pr_funcs: makelist(funcstoplot[reordering[i]],i,1,4);

corr:maplist(lambda([ex],assoc(ex,fntoletter)), [1,2,3,4]);
ta1:maplist(lambda([ex],[ex, is(ex=assoc(1,fntoletter))]), [A,B,C,D]);
ta2:maplist(lambda([ex],[ex, is(ex=assoc(2,fntoletter))]), [A,B,C,D]);
ta3:maplist(lambda([ex],[ex, is(ex=assoc(3,fntoletter))]), [A,B,C,D]);
ta4:maplist(lambda([ex],[ex, is(ex=assoc(4,fntoletter))]), [A,B,C,D]);
thumbnailplot:lambda([ex1,ex2],plot(ex1,[t,-2*T,2*T],[y,-a,a],[box, false],[yx_ratio, 1],[xtics, -T, 2*T, T],[ytics, -a, 2*a, a],[axes, solid],[size,170,170],[plottags,false],[alt,ex2]));]]></text>
