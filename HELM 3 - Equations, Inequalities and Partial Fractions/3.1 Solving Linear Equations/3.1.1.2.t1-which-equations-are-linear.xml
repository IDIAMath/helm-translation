    </li>
    <li>
        {@eq2@} [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]
    </li>
    <li>
        {@eq3@} [[input:ans3]] [[validation:ans3]] [[feedback:prt3]]
    </li>
    <li>
        {@eq4@} [[input:ans4]] [[validation:ans4]] [[feedback:prt4]]
    </li>
</ol>
]]></text>
        </questiontext>
        <generalfeedback format="html">
            <text><![CDATA[
<ol class="HELM_parts">
    <li>
        <span class="multilang" lang="en">
            {@eq1@} is a linaer equation in \(x.\)
        </span>
        <span class="multilang" lang="de">
            {@eq1@} ist eine lineare Gleichung in \(x\).
        </span>
    </li>
    <li>
        <span class="multilang" lang="en">
            {@eq2@} is a linear equation in \(t.\)
        </span>
        <span class="multilang" lang="de">
            {@eq2@} ist eine lineare Gleichung in \(t\).
        </span>
    </li>
    <li>
        <span class="multilang" lang="en">
            {@eq3@} is not a linear equation. There is a quadratic term {@a1*x^2@}.
        </span>
        <span class="multilang" lang="de">
            {@eq3@} ist keine lineare Gleichung. Es gibt einen quadratischen Term {@a1*x^2@}.
        </span>
    </li>
    <li>
        <span class="multilang" lang="en">
            {@eq4@} is a linear equation in \(p\) where the constant term is zero.
        </span>
        <span class="multilang" lang="de">
            {@eq4@} ist eine lineare Gleichung in \(p\), bei der der konstante Term Null ist.
        </span>
    </li>
</ol>
]]></text>
