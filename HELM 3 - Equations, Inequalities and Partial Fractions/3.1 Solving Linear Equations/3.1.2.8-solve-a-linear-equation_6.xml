        <generalfeedback format="html">
            <text><![CDATA[
<ol class="HELM_parts">
    <li>
        <p>
            \(\begin{align} {@a1@}-{@b1@}({@c1*t@}+{@d1@})= {@e1*(f1*t+g1)@} &amp; \Rightarrow \\ {@expand(lhs1)@} = {@expand(rhs1)@} &amp; \Rightarrow \\ t= {@ta1@}. \end{align}\)
        </p>
    </li>
    <li>
        <p>
            \(\begin{align} {@a5*m - b5 + a5*(m - b5) = m@} &amp; \Rightarrow \\ {@expand(lhs2)@} = {@expand(rhs2)@} &amp; \Rightarrow \\ m= {@ta5@}. \end{align}\)
        </p>
    </li>
    <li>
        <p>
            \(\begin{align} {@(1/a6)@}({@x@} + {@b6@}) = {@c6@} &amp; \Rightarrow \\ {@x@} + {@b6@}= {@a6*c6@} &amp; \Rightarrow \\ x={@ta6@}. \end{align}\)
        </p>
    </li>
</ol>
]]></text>
