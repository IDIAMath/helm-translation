        <questionvariables>
            <text>ordergreat(x,y);

a1: rand([2,4]);
b1: rand([3,5])
A1: matrix([a1,-a1],[b1,1]);
B1:matrix([x],[y]);
sysl1:A1.B1;
s1: -(rand(4)+2);
s2: rand_with_prohib(-4,-1,[s1]);
ta:matrix([s1],[s2]);
sysr1:A1.ta;

eq1: (a1*x)/a1-sysr1[1,1]/a1;
eq2: -b1*x+sysr1[2,1];</text>
