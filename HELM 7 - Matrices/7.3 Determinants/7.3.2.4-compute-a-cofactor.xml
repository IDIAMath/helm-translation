        <questionvariables>
            <text>matrixa: matrix([rand_with_step(-5,5,1),rand_with_step(-5,5,1),rand_with_step(-5,5,1)],[rand_with_step(-5,5,1),rand_with_step(-5,5,1),rand_with_step(-5,5,1)],[rand_with_step(-5,5,1),rand_with_step(-5,5,1),rand_with_step(-5,5,1)]);
matrixa: ev(matrixa,simp);
AA: matrixa;
ta1: ev(AA[1,1]*AA[3,3]-AA[1,3]*AA[3,1],simp);
minorA22: unary_minus_sort(AA[1,1]*AA[3,3]-AA[1,3]*AA[3,1]);
minorA23s: ev(AA[1,1]*AA[3,2]-AA[1,2]*AA[3,1],simp);
minorA23: unary_minus_sort(AA[1,1]*AA[3,2]-AA[1,2]*AA[3,1]);
cofA23 : ev(-minorA23s,simp);</text>
        </questionvariables>
