<quiz>
    <question type="stack">
        <name>
            <text>1.2.2.2  Schreiben Sie eine einzelne Potenz [Write single index]</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[
<p class="HELM_exercise">
    <span class="multilang" lang="en">
        Exercise
    </span>
    <span class="multilang" lang="de">
        Übung
    </span>
    <br/>
</p>
<p>
    <span class="multilang" lang="en">
        Write each of the following expressions with a single index:
    </span>
    <span class="multilang" lang="de">
        Schreiben Sie jeden der folgenden Ausdrücke mit einer einzigen Potenz:
    </span>
</p>
<ol class="HELM_parts">
    <li>
        <p>
            \({@a1@}^{@a2@}{@a1@}^{@a3@}=\) [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]
        </p>
    </li>
    <li>
        <p>
            \(\dfrac{{@b1@}^{@b2@}}{{@b1@}^{@b3@}}=\) [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]
        </p>
    </li>
    <li>
        <p>
            \((x^{@c1@})^{@c2@}=\) [[input:ans3]] [[validation:ans3]] [[feedback:prt3]]
        </p>
    </li>
</ol>
]]></text>
        </questiontext>
        <generalfeedback format="html">
            <text><![CDATA[
<p dir="ltr" style="text-align: left;">
    <br/>
</p>
<ol class="HELM_parts">
    <li>
        <p>
            <span class="multilang" lang="en">
                We use the first law of indices, so we sum the powers to obtain:
            </span>
            <span class="multilang" lang="de">
                Wir verwenden das erste Potenzgesetz, also addieren wir die Potenzen, um zu erhalten:
            </span>
        </p>
        <p>
            \({@a1@}^{@a2@}{@a1@}^{@a3@} = {@a1@}^{{@a2@}+{@a3@}} = {@ta1@}. \)
        </p>
    </li>
    <li>
        <p>
            <span class="multilang" lang="en">
                We use the second law of indices, so we subtract the powers to obtain:
            </span>
            <span class="multilang" lang="de">
                Wir verwenden das zweite Potenzgesetz, also subtrahieren wir die Potenzen, um zu erhalten:
            </span>
        </p>
        <p>
            \(\dfrac{{@b1@}^{@b2@}}{{@b1@}^{@b3@}} = {@b1@}^{{@b2@}-{@b3@}} = {@ta2@}. \)
        </p>
    </li>
    <li>
        <p>
            <span class="multilang" lang="en">
                We use the third law of indices, so we multiply both powers to obtain:
            </span>
            <span class="multilang" lang="de">
                Wir verwenden das dritte Potenzgesetz, also multiplizieren wir beide Potenzen, um zu erhalten:
            </span>
        </p>
        <p>
            \((x^{@c1@})^{@c2@}= x^{{@c1@}\times{@c2@}} = {@ta3@}. \)
        </p>
    </li>
</ol>
]]></text>
        </generalfeedback>
