            <text>a1: rand([3,4,5,6]);
a2: ev(a1+1, simp:true);
a3: ev(a1+3, simp:true);
a4: ev(a2+a3, simp:true);
ta1: a1^a4;

b1: rand([3,4,5,6]);
b2: ev(b1+1, simp:true);
b3: ev(b1+13, simp:true);
b4: ev(b2-b3, simp:true);
ta2: b1^(b4);

c1: rand([4,5,6,7]);
c2: ev(c1-1, simp:true);
c3: ev(c1*c2, simp:true);
ta3: x^c3;</text>
