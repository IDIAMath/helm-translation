        <questionvariables>
            <text>simp:false;

a1:ev(rand(4)+2, simp);
a2: ev(a1+1, simp);
a3: a2;
exp1: (a1/a2)*x^2 + x^2/a3;
ta1:ev(exp1,simp);


b1: 0.5;
b2: rand([3,5]);
b3: 4;
b4: rand([7,9,11,13]);
b5:2;
exp2: b1*x^2 + (b2/b3)*x^2  - b4/b5*x;
ta2: ev(exp2,simp);

c1: ev(rand(4)+3,simp);
c2: ev(c1+4,simp);
c3:c1;
c4:c2;
exp3: c1*x^3 - c2*x + c3*y*x + c4;
ta3: c1*x^3 - c2*x + c3*y*x + c4;

d1: rand([2,3,4]);
exp4: -d1*a*x^2 + b*x^2;
ta4:(b - d1*a)*x^2;</text>
