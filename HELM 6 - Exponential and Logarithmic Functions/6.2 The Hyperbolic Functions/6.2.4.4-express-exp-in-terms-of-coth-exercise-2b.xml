        <questionvariables>
            <text>aa: rand(6)+2;
uu: rand([3,5,7]);
vv: rand([2,4,8]);
xx: rand([x,y,z,t]);
exp: cosh(aa*xx) + sinh(aa*xx);
expn: cosh(aa*xx) - sinh(aa*xx);
nn: uu*exp(aa*xx); 
dd: vv*exp(aa*xx) - vv*expn(aa*xx);
ta: (uu/(2*vv))*coth(aa*xx) + uu/(2*vv);
ta1: factor(ta);
ta2: uu*(coth(aa*xx)/(2*vv) + 1/(2*vv));</text>
