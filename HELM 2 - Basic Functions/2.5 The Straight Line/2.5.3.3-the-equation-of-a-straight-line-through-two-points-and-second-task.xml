            <text>var1:x;
var2:y;

x3: rand_with_prohib(-9,9,[0]);
x4: rand_with_prohib(-9,9,[x3]);
y3: rand_with_step(-9,9,1);
y4: rand_with_prohib(-9,9,[y3]);
solution2: var2=(y4-y3)*(var1)/(x4-x3)+((y4-y3)*(-x3)/(x4-x3)+y3);

x5: rand_with_prohib(-9,9,[0]);
x6: rand_with_prohib(-9,9,[x5]);
y5: rand_with_step(-9,9,1);
y6: rand_with_prohib(-9,9,[y5]);
lineq: var2=(y6-y5)*(var1)/(x6-x5)+((y6-y5)*(-x5)/(x6-x5)+y6);

simp:false;   /* turn simp off so that display nice signs in worked solution */
grad1: (y4-y3)/(x4-x3);
grad2: (y6-y5)/(x6-x5);  
grad: ev(grad2,simp);
vert1: ((y6-y5)*(-x5)/(x6-x5)+y5);
vert: ev(vert1,simp);</text>
